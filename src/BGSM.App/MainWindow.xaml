<Window
    x:Class="BGSM.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BG Sales Management">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Padding="20" Spacing="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <TextBlock Text="BG Sales Management" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="QUẢN LÝ" FontSize="12" Opacity="0.65" Margin="0,12,0,0" />
            <Button Content="Tổng quan" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Overview_Click" />
            <Button Content="Khách hàng" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Customers_Click" />
            <Button Content="Lịch làm việc" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="ComingSoon_Click" />
            <Button Content="Nhập dữ liệu" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="ComingSoon_Click" />
            <Button Content="Cài đặt" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="ComingSoon_Click" />
            <TextBlock Text="Bản nền tảng đang phát triển" TextWrapping="Wrap" Opacity="0.6" Margin="0,24,0,0" />
        </StackPanel>

        <Grid Grid.Column="1" Padding="32">
            <Grid x:Name="OverviewPanel" Visibility="Visible">
                <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="Tổng quan" FontSize="30" FontWeight="SemiBold" />
                    <InfoBar IsOpen="True" Severity="Success" Title="Kết nối dữ liệu" Message="Ứng dụng sẽ tự tạo cơ sở dữ liệu SQLite trên máy khi khởi động." />
                    <TextBlock Text="Chào mừng đến với BG Sales Management." FontSize="18" />
                    <TextBlock Text="Bản hiện tại đã có nền tảng lưu trữ và màn hình quản lý khách hàng cơ bản. Các chức năng lịch làm việc và nhập Excel sẽ được bổ sung ở bước tiếp theo." TextWrapping="Wrap" />
                    <Button Content="Mở danh sách khách hàng" Click="Customers_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>

            <Grid x:Name="CustomersPanel" Visibility="Collapsed" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Spacing="6">
                    <TextBlock Text="Khách hàng" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Danh sách được đọc trực tiếp từ cơ sở dữ liệu SQLite trên máy." Opacity="0.7" />
                </StackPanel>
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" PlaceholderText="Tìm theo tên, mã, số điện thoại hoặc khu vực..." TextChanged="SearchBox_TextChanged" />
                    <Button Grid.Column="1" Content="Làm mới" Click="Refresh_Click" />
                    <Button Grid.Column="2" Content="+ Thêm khách hàng" Click="AddCustomer_Click" />
                </Grid>
                <ListView x:Name="CustomerList" Grid.Row="2" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,10" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ExcelCustomerCode, TargetNullValue='Chưa có mã'}" Opacity="0.65" FontSize="12" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Region, TargetNullValue='Chưa có khu vực'}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Phone, TargetNullValue='Chưa có số điện thoại'}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="StatusText" Grid.Row="3" Text="Đang tải dữ liệu..." Opacity="0.7" />
            </Grid>
        </Grid>
    </Grid>
</Window>